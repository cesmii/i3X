{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "$id": "https://abelara.com/equipment/v1.0",
    "types": {
        "state-type": {
            "type": "object",
            "properties": {
                "timestamp": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "color": {
                    "type": "string"
                },
                "type": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "integer"
                        },
                        "name": {
                            "type": "string"
                        },
                        "description": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "id",
                        "name",
                        "description"
                    ]
                },
                "metadata": {
                    "type": "object",
                    "properties": {
                        "source": {
                            "type": "string"
                        },
                        "uri": {
                            "type": "string"
                        },
                        "asset": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "integer"
                                },
                                "name": {
                                    "type": "string"
                                },
                                "description": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "id",
                                "name",
                                "description"
                            ]
                        },
                        "previousState": {
                            "type": "object",
                            "properties": {
                                "id": {
                                    "type": "integer"
                                },
                                "name": {
                                    "type": "string"
                                },
                                "description": {
                                    "type": "string"
                                },
                                "color": {
                                    "type": "string"
                                },
                                "type": {
                                    "type": "object",
                                    "properties": {
                                        "id": {
                                            "type": "integer"
                                        },
                                        "name": {
                                            "type": "string"
                                        },
                                        "description": {
                                            "type": "string"
                                        }
                                    },
                                    "required": [
                                        "id",
                                        "name",
                                        "description"
                                    ]
                                }
                            },
                            "required": [
                                "id",
                                "name",
                                "description",
                                "color",
                                "type"
                            ]
                        },
                        "additionalInfo": {
                            "type": "object",
                            "properties": {
                                "runTime": {
                                    "type": "integer"
                                },
                                "lastFillTime": {
                                    "type": "string"
                                },
                                "mode": {
                                    "type": "string"
                                },
                                "operator": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "runTime",
                                "lastFillTime",
                                "mode",
                                "operator"
                            ]
                        }
                    },
                    "required": [
                        "source",
                        "uri",
                        "asset"
                    ]
                }
            },
            "required": [
                "timestamp",
                "description",
                "color",
                "type",
                "metadata"
            ]
        },
        "product-type": {
            "description": "Product metadata container - no records, metadata only",
            "type": "object"
        },
        "production-type": {
            "description": "Production container - no records, organizational metadata with HasChildren relationships",
            "type": "object"
        },
        "measurements-type": {
            "description": "Composite measurements container - no records, composed of measurement-type children",
            "type": "object"
        },
        "measurement-type": {
            "description": "Composite measurement type composed of value and health subtypes, with tolerance metadata in records",
            "type": "object",
            "properties": {
                "tolerance": {
                    "type": "number",
                    "description": "Acceptable deviation from target value"
                },
                "inTolerance": {
                    "type": "boolean",
                    "description": "Whether current value is within tolerance"
                },
                "value": {
                    "$ref": "#/types/measurement-value-type",
                    "description": "Composed child: measurement value"
                },
                "health": {
                    "$ref": "#/types/measurement-health-type",
                    "description": "Composed child: measurement health indicator"
                }
            },
            "required": [
                "tolerance",
                "inTolerance"
            ]
        },
        "measurement-value-type": {
            "type": "number"
        },
        "measurement-health-type": {
            "type": "integer"
        }
    }
}